GARMIN_EMAIL=
GARMIN_PASSWORD=
# Optional: path to a token directory, or the JSON string printed by `python login.py --print`
GARMIN_TOKENS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Shared secret the frontend must send. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_TOKEN=
# Comma-separated list of frontend origins
ALLOWED_ORIGINS=http://localhost:5173
CACHE_TTL_S=300
